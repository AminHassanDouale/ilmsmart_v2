1780589059a:2:{s:5:"verse";a:6:{s:9:"verse_key";s:4:"5:35";s:4:"ayah";i:35;s:6:"arabic";s:270:"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَٱبْتَغُوٓا۟ إِلَيْهِ ٱلْوَسِيلَةَ وَجَـٰهِدُوا۟ فِى سَبِيلِهِۦ لَعَلَّكُمْ تُفْلِحُونَ";s:15:"transliteration";s:115:"Ya ayyuha allatheena amanooittaqoo Allaha wabtaghoo ilayhi alwaseelata wajahidoofee sabeelihi laAAallakum tuflihoon";s:12:"translations";a:8:{s:19:"sahih_international";s:122:"O you who have believed, fear Allāh and seek the means [of nearness] to Him and strive in His cause that you may succeed.";s:9:"pickthall";s:142:"O ye who believe! Be mindful of your duty to Allah, and seek the way of approach unto Him, and strive in His way in order that ye may succeed.";s:9:"yusuf_ali";s:143:"O ye who believe! Do your duty to Allah, seek the means of approach unto Him, and strive with might and main in his cause: that ye may prosper.";s:4:"urdu";s:266:"اے لوگو جو ایمان لائے ہو، اللہ سے ڈرو اور اُس کی جناب میں بار یابی کا ذریعہ تلاش کرو1 اور اس کی راہ میں جدوجہد کرو،2 شاید کہ تمہیں کامیابی نصیب ہوجائے";s:7:"turkish";s:101:"Ey İnananlar! Allah'tan sakının, O'na ulaşmaya yol arayın, yolunda cihad edin ki kurtulasınız.";s:10:"indonesian";s:184:"Wahai orang-orang yang beriman! Bertakwalah kepada Allah dan carilah wasilah (jalan) untuk mendekatkan diri kepada-Nya, dan berjihadlah (berjuanglah) di jalan-Nya, agar kamu beruntung.";s:6:"french";s:156:"Ô les croyants ! Craignez Allah, et cherchez le moyen de vous rapprocher de Lui et luttez pour Sa cause. Peut-être serez-vous de ceux qui réussissent ! 1";s:6:"german";s:142:"O die ihr glaubt, fürchtet Allah und trachtet nach einem Mittel zu Ihm und müht euch auf Seinem Weg ab, auf daß es euch wohl ergehen möge!";}s:5:"audio";a:2:{s:10:"ayah_audio";s:53:"https://everyayah.com/data/Alafasy_128kbps/005035.mp3";s:12:"all_reciters";s:21:"/api/quran/audio/5/35";}}s:5:"surah";a:8:{s:6:"number";i:5;s:11:"name_arabic";s:14:"المائدة";s:12:"name_english";s:10:"Al-Ma'idah";s:16:"name_translation";s:16:"The Table Spread";s:16:"revelation_place";s:7:"madinah";s:16:"revelation_order";i:112;s:12:"verses_count";i:120;s:13:"bismillah_pre";b:1;}}